# Leave empty in local development to disable the lock.
APP_PASSCODE=

# Shown in the greeting. Optional.
APP_NAME=

# Everything is computed in this timezone. The day rolls over at 01:30 local.
APP_TZ=Asia/Kolkata

# Optional. Without these the app uses .data/db.json instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web push. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/*. Vercel sends it automatically when this is set.
CRON_SECRET=
